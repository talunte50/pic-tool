---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getLang } from '@i18n/index';

const t = getLang().legal;
---

<Layout title={`${t.termsTitle} | pic-tool`} description={t.termsIntro1.slice(0, 150)}>
    <Header />
    <article
        class='prose prose-zinc mx-auto container py-12 dark:prose-invert'
    >
        <div class='space-y-2 not-prose'>
            <h1
                class='text-4xl font-extrabold tracking-tight lg:text-5xl lg:leading-[3.5rem]'
            >
                {t.termsTitle}
            </h1>
            <p class='text-zinc-500 dark:text-zinc-400'>
                {t.termsUpdated}
            </p>
        </div>
        <div class='mt-6'>
            <h2>{t.termsH2Intro}</h2>
            <p>{t.termsIntro1}</p>
            <p>{t.termsIntro2}</p>
            <h2>{t.termsH2Use}</h2>
            <p>{t.termsUse1}</p>
            <h2>{t.termsH2Access}</h2>
            <p>{t.termsAccess1}</p>
            <h2>{t.termsH2Ip}</h2>
            <p>{t.termsIp1}</p>
            <h2>{t.termsH2Warranty}</h2>
            <p>{t.termsWarranty1}</p>
            <p>{t.termsWarranty2}</p>
            <h2>{t.termsH2Law}</h2>
            <p>{t.termsLaw1}</p>
            <h2>{t.termsH2Changes}</h2>
            <p>{t.termsChanges1}</p>
        </div>

        <!--AFTER-CONTENT-->
    </article>
    <Footer />
</Layout>
