# ============ 广告总开关 ============
# true = 启用百度联盟广告；false = 完全关闭（推荐部署前先用 false 验证）
PUBLIC_ENABLE_ADS=false

# ============ 百度联盟 H5 广告位配置 ============
# 渠道 ID（百度联盟后台 → 广告位管理 → 你的 H5 广告位 → 代码段里的 p 值）
PUBLIC_Baidu_Pid=

# 广告位宽高（像素）。H5 通栏常用 750x90；移动端 375x90
PUBLIC_Baidu_AdsWidth=750
PUBLIC_Baidu_AdsHeight=90

# ============ 广告位矩阵开关 ============
# banner（页面顶/底横幅）默认开启，随 PUBLIC_ENABLE_ADS。
# interstitial（结果完成后插层）与 infeed（原生信息流）默认关闭，按需开启。
PUBLIC_ENABLE_INTERSTITIALS=false
PUBLIC_ENABLE_INFEED=false

# ============ 背景去除模型（可选） ============
# 默认 Xenova/modnet（~21MB，效果好、加载快）。
# 想用更强的模型（如 BiRefNet）可改成对应 Hugging Face 仓库名，但体积更大、首载更慢。
# PUBLIC_REMOVE_BG_MODEL=Xenova/modnet

# ============ 网站基础配置（可选覆盖） ============
# 如果你的部署域名和 pic-tool.fun 不同，建议改 src/lib/config.js 里的 CONFIG.website
# 这里只是占位说明，config.js 里写死的是 'https://pic-tool.fun'

# ============ 备注 ============
# Astro 的 import.meta.env 只在构建时读取 PUBLIC_* 前缀的变量。
# EdgeOne 部署时：
#   方式 A（本地构建）：cp .env.example .env，填好值，pnpm build，上传 dist/
#   方式 B（CI/CD 构建）：在 EdgeOne 控制台「环境变量」里配置同名键值，构建脚本会自动读取
# 详见 DEPLOY.md
