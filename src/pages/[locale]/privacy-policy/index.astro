---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { CONFIG } from '@lib/config';
import { getLang } from '@i18n/index';

export function getStaticPaths() {
    return CONFIG.locals.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params;
const dict = getLang(locale);
// 各语言未提供 legal 命名空间时回退英文（与原硬编码行为一致，无回归）
const t = dict.legal || getLang('en').legal;
---

<Layout title={`${t.privacyTitle} | pic-tool`} description={dict.description}>
    <Header />
    <article
        class='prose prose-zinc mx-auto container py-12 dark:prose-invert'
    >
        <div class='space-y-2 not-prose'>
            <h1
                class='text-4xl font-extrabold tracking-tight lg:text-5xl lg:leading-[3.5rem]'
            >
                {t.privacyTitle}
            </h1>
            <p class='text-zinc-500 dark:text-zinc-400'>
                {t.privacyUpdated}
            </p>
        </div>
        <div class='mt-6'>
            <p>{t.privacyIntro}</p>
            <h2>{t.privacyH2Data}</h2>
            <p>
                {t.privacyP1Pre}<a href='https://usefathom.com/'>{t.privacyP1Link}</a>{t.privacyP1Post}
            </p>
            <p>{t.privacyP2}</p>
            <p>{t.privacyP3}</p>
            <ul>
                <li>{t.privacyLi1}</li>
                <li>{t.privacyLi2}</li>
                <li>{t.privacyLi3}</li>
                <li>{t.privacyLi4}</li>
                <li>{t.privacyLi5}</li>
            </ul>
            <p>{t.privacyP4}</p>
            <h2>{t.privacyH2Use}</h2>
            <p>{t.privacyP5}</p>
            <h2>{t.privacyH2Share}</h2>
            <p>{t.privacyP6}</p>
            <h2>{t.privacyH2Retention}</h2>
            <p>{t.privacyP7}</p>
            <h2>{t.privacyH2Rights}</h2>
            <p>{t.privacyP8}</p>
            <p>{t.privacyP9}</p>
        </div>

        <!--AFTER-CONTENT-->
    </article>
    <Footer />
</Layout>
