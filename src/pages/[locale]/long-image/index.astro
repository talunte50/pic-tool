---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import LongImageComposerPage from '@components/LongImageComposerPage.astro';
import { getLang } from '@i18n/index';
const { locale } = Astro.params;
const t = getLang(locale)
const { title, description, keywords } = t.longImage;
---

<Layout title={title} description={description} keywords={keywords}>
    <main class="relative overflow-hidden min-h-screen flex flex-col bg-[radial-gradient(60%_40%_at_50%_0%,rgba(79,70,229,0.10),transparent_70%)]">

        <Header />
        <LongImageComposerPage />
        <Footer />
    </main>
</Layout>
