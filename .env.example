# ============ 广告源选择 ============
# google | baidu | none   （留空=自动推断：配了 AdSense 客户端就用 google，否则用百度）
PUBLIC_ADS_PROVIDER=google

# ============ Google AdSense（推荐） ============
# 发布商 ID：AdSense 后台左下角「账号 → 发布商 ID」，形如 ca-pub-6098563075584509
# 必填。配了它，head 里才会自动注入 adsbygoogle.js（同时也是「自动广告 Auto Ads」的启用脚本）
PUBLIC_GOOGLE_ADS_CLIENT=ca-pub-6098563075584509

# 手动广告单元 ID：AdSense 后台 → 广告 → 按广告单元 → 新建「展示广告」→ 代码里的 data-ad-slot
# 只有配了这个，AdSlot 组件才会在页面上渲染出 <ins> 广告位。
# 如果只用「自动广告(Auto Ads)」，这几个留空即可，Google 会自己找位置投放。
PUBLIC_GOOGLE_AD_SLOT=

# 各站点的专用广告单元（留空则退回上面的 PUBLIC_GOOGLE_AD_SLOT）
PUBLIC_GOOGLE_AD_SLOT_INTERSTITIAL=
PUBLIC_GOOGLE_AD_SLOT_INFEED=

# 版式：auto（响应式，推荐）| rectangle | vertical | horizontal
PUBLIC_GOOGLE_AD_FORMAT=auto

# 测试模式 true：显示占位测试广告，不消耗真实展示、不算无效流量。上线前请改回 false
PUBLIC_GOOGLE_ADS_TEST=false

# ============ 百度联盟 H5（旧方案，保留） ============
# 只有当 PUBLIC_ADS_PROVIDER=baidu 时才生效
# true = 启用百度联盟广告；false = 关闭
PUBLIC_ENABLE_ADS=false

# 渠道 ID（百度联盟后台 → 广告位管理 → 你的 H5 广告位 → 代码段里的 p 值）
PUBLIC_Baidu_Pid=

# 广告位宽高（像素）。H5 通栏常用 750x90；移动端 375x90
PUBLIC_Baidu_AdsWidth=750
PUBLIC_Baidu_AdsHeight=90

# ============ 广告位矩阵开关 ============
# banner（页面顶/底横幅）默认开启，随广告源开关。
# interstitial 与 infeed 默认关闭，按需开启。
#   布局位置：Layout.astro 顶部/底部 = banner；RemoverPage 精修完成后 = interstitial；页面底部 = infeed
PUBLIC_ENABLE_INTERSTITIALS=false
PUBLIC_ENABLE_INFEED=false

# ============ 背景去除模型（可选） ============
# 默认 Xenova/modnet（~21MB，效果好、加载快）。
# 想用更强的模型（如 BiRefNet）可改成对应 Hugging Face 仓库名，但体积更大、首载更慢。
# PUBLIC_REMOVE_BG_MODEL=Xenova/modnet

# ============ 网站基础配置（换域名必改） ============
# canonical / og:url / hreflang / llms.txt 全部由 src/lib/config.js 的 CONFIG.website 驱动。
# 当前写死的是 'https://pic.nxzai.cc.cd'。
# 换成自己的域名时：改 src/lib/config.js 的 CONFIG.website，然后重新构建部署；
# 同时记得同步 public/llms.txt 里的链接。
# 注意：pic-tool.fun 并未注册，不要再指回该域名。

# ============ 备注 ============
# Astro 的 import.meta.env 只在构建时读取 PUBLIC_* 前缀的变量 —— 改完必须重新构建。
# EdgeOne 部署时：
#   方式 A（本地构建）：cp .env.example .env，填好值，pnpm build，上传 dist/
#   方式 B（CI/CD 构建）：在 EdgeOne 控制台「环境变量」里配置同名键值
# 详见 DEPLOY.md
